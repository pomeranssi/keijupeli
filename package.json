{
  "name": "keijupeli",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "homepage": "https://keijupeli.pomeranssi.fi/",
  "scripts": {
    "watch-client": "vite",
    "watch-server": "DEBUG='server*' tsx watch --tsconfig tsconfig.server.json src/server/keijupeliServer.ts",
    "build-client": "vite build",
    "build-server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json && node -e \"require('fs').writeFileSync('build-server/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node -e \"require('fs').writeFileSync('build-server/yarn.lock', '')\"",
    "preview-client": "vite preview",
    "clean": "rm -rf build/ dist/ build-server/",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "vitest run",
    "test-watch": "vitest",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate-make": "knex --knexfile knexfile.cjs migrate:make",
    "migrate-rollback": "knex --knexfile knexfile.cjs migrate:rollback"
  },
  "dependencies": {
    "debug": "4.4.3",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "history": "5.3.0",
    "knex": "3.3.0",
    "luxon": "3.7.2",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pg-promise": "12.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.5",
    "styled-components": "6.6.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/multer": "2.3.0",
    "@types/node": "25.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
